# ---------------------------------------------------------------------------
# Existing (CV / LLM)
# ---------------------------------------------------------------------------

GOOGLE_API_KEY=key_i_need_some_computer_vision_skills_and_im_too_dumb_to_implement_an_algorithm_of_my_own
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# VISION_DETECTOR selects the detector DetectorFactory.build() constructs inside
# process_image. DetectorFactory.build() honors these names:
#   mock   = dev (no API calls) — the example default so the upload→poll→result
#            round-trip works without creds
#   google = prod (requires GOOGLE_API_KEY)
#   ollama = local LLM (requires OLLAMA_HOST, OLLAMA_MODEL)
# Unset → defaults to "google" (prod-shape).
VISION_DETECTOR=mock

# S-03: MockDetector configuration (only honored when VISION_DETECTOR=mock).
#   MOCK_DETECTOR_HOLE_COUNT — how many holes the mock emits (default 10).
#   MOCK_DETECTOR_SEED       — if set, the random hole pattern is deterministic
#                              (tests pin this); unset → varies per run so the
#                              dev loop's accept→persist→aggregate round-trip
#                              exercises varied data. Optional.
# MOCK_DETECTOR_HOLE_COUNT=10
# MOCK_DETECTOR_SEED=

# django-q2 worker count for the async CV pipeline (AGENTS.md §2 cap is 3).
# Default 3 for local/dev so `make dev` is unaffected; the Railway IaC narrows
# to 1 via Q2_WORKERS=1 to fit the Free-tier 512MB RAM budget. Leave unset for
# native dev (infrastructure-as-code P1).
# Q2_WORKERS=3

# ---------------------------------------------------------------------------
# F-01: OAuth + Roles scaffold (Auth0 OIDC BFF)
# ---------------------------------------------------------------------------

# Auth0 OIDC client. Leave empty in dev — the dev-bypass middleware makes
# Auth0 optional locally (Phase 4). Required for the real OAuth flow.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# 64-char random string used to encrypt the session cookie + sign CSRF tokens.
# Django reads this as SECRET_KEY (AUTH0_SECRET is the canonical name; the
# SECRET_KEY alias below is accepted too). Generate with: openssl rand -hex 32.
AUTH0_SECRET=

# The deploy URL. When ALLOWED_HOSTS is unset, Django derives the host
# allowlist from this (e.g. http://localhost:8000 → ALLOWED_HOSTS=["localhost"]).
APP_BASE_URL=http://localhost:8000

# The single source of truth for the Owner role. ``User.role`` derives Owner
# by comparing ``self.sub == OWNER_SUB_ID`` (never persisted). Empty → fails
# closed (no one is Owner); W001 warns in prod. Phase 5: the first-ever login
# logs its sub at WARNING level — copy it here, restart, and that user becomes
# Owner on their next login.
# IMPERSONATION (dev only): set DEV_AUTH_BYPASS_SUB equal to this value to
# log in locally AS the Owner without touching Auth0.
OWNER_SUB_ID=

# Dev-only auth bypass: when set AND DEBUG=True, every request is authenticated
# as this sub's user (Phase 4 middleware). target_o_meter.E001 refuses to boot
# if this is set while DEBUG=False. DO NOT set in production.
DEV_AUTH_BYPASS_SUB=

# Seeded dev admin (Django admin login). Dev-only. ``create_superuser``
# requires a usable password here.
DEV_ADMIN_SUB=
DEV_ADMIN_NICK=dev-admin
DEV_ADMIN_PASSWORD=

# Cookie SECURE flag toggle. False in dev (no HTTPS on localhost); True in prod.
SECURE_COOKIES=False

# django-vite serving mode (S-02 impl-review F11). Defaults to DEBUG: native
# `make dev` keeps HMR (dev_mode=True → entry tag points at :5173). The dev
# container sets DJANGO_VITE_DEV_MODE=False because docker-compose.dev.yml runs
# no Vite service — the dev image bakes the bundle and django-vite serves it
# from dist/manifest.json instead. Leave UNSET for native dev.
DJANGO_VITE_DEV_MODE=

# Django core (already read by settings.py).
# DEBUG=True in dev; False in prod (E001 guards the dev-bypass under DEBUG=False).
# SECRET_KEY=<alias for AUTH0_SECRET; AUTH0_SECRET wins if both are set>
# ALLOWED_HOSTS=<optional; derived from APP_BASE_URL when unset>

# ---------------------------------------------------------------------------
# S-02: Storage (S3 swap)
# ---------------------------------------------------------------------------
#
# Flip STORAGES['default'] between FileSystemStorage and django-storages' S3
# backend. USE_S3=False (default) keeps the no-creds host-dev path on the local
# filesystem; the dev-server, host tests, and `make dev` all run this way.
# USE_S3=True is set ONLY inside docker-compose (MinIO) and prod (Railway
# Storage Buckets / Tigris) — flipping it without the matching AWS_* vars below
# raises a loud KeyError at boot (settings.py reads these with os.environ[...]).

USE_S3=False

# When USE_S3=True, settings.py reads the AWS_* vars below with os.environ[...]
# (a missing prod var is a loud KeyError at boot). MinIO dev creds are
# minioadmin / minioadmin; prod uses Tigris (Railway Storage Buckets) creds.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket name. Dev (docker-compose): target-o-meter-local (created by the
# create-bucket service). Prod: your Railway Storage Bucket name.
AWS_STORAGE_BUCKET_NAME=

# MinIO only: the S3 endpoint URL. http://localhost:9000 (host) or
# http://minio:9000 (compose). UNSET (leave empty) for Tigris/Railway prod.
AWS_S3_ENDPOINT_URL=

# Path-style addressing for MinIO; "auto" (default) for Tigris.
AWS_S3_ADDRESSING_STYLE=auto
