# Vite + node toolchain artifacts. `dist/` is produced by `npm run build` and
# consumed by django-vite in prod, but is fully reproducible from source —
# never commit build output.
node_modules/
dist/
.vite/

# Local npm logs / cache (defense in depth).
*.log
npm-debug.log*

# Playwright acceptance test artifacts (screenshots, videos, traces on
# failure). The live-stack run dir lives under results/ (gitignored at the
# repo root); these are the per-test-failure captures.
test-results/
playwright-report/
